  .masthead-inner{max-width:var(--maxw); margin:0 auto;}
  .eyebrow{
    font-family:"JetBrains Mono",monospace;
    font-size:12px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:#9FB4D8;
    display:flex;
    gap:10px;
    align-items:center;
    margin-bottom:18px;
  }
